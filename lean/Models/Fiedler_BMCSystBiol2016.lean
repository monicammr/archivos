/-- Las potencias reales de G son raíces cuadradas. -/
theorem half_ok : ∀ i, ∀ r ∈ rpowExps (G i), r = 1 / 2 := by
  intro i; fin_cases i <;> simp [rpowExps, G]

/-- **Teorema final, sin condiciones pendientes**: para todo T ≥ 0 la solución
